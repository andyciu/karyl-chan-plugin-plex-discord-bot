# ============================================
# karyl-chan-bot + karyl-plex 環境變數設定
# ============================================
# 複製此檔案為 .env 並填入實際值
# 或在執行 docker compose 前 export 這些變數

# ============================================
# Discord Bot 設定（必填）
# ============================================

# 從 Discord Developer Portal 取得
# https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# 32 位元 hex 字串，用於加密敏感資料
# 產生方式（PowerShell）:
#   powershell -Command "[System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32) | ForEach-Object { $_.ToString('x2') }"
# 產生方式（Linux/Mac）:
#   openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Bot 擁有者的 Discord User ID
# 可在 Discord 開啟開發者模式，按右鍵點擊使用者選擇「複製用戶ID」
# 多個請用逗號分隔
BOT_OWNER_IDS=your_discord_user_id_here

# ============================================
# Plex 設定（必填）
# ============================================

# Plex Media Server 的 IP 或 hostname
# 如果是本機網路可用 192.168.x.x 或 computer-name.local
PLEX_HOSTNAME=your-plex-server.local

# Plex 伺服器 port，預設 32400
PLEX_PORT=32400

# Plex 認證 Token（必填）
# 取得方式：
#   1. 登入 plex.tv
#   2. 前往 Settings > Plex TV > Your Apps
#   3. 或訪問 https://plex.tv/pms/servers.xml（需登入）
PLEX_TOKEN=your_plex_token_here

# 音樂庫 section key，可從 /library/sections 取得，預設 1
PLEX_SECTIONS_KEY=1

# 預設音量 0-100，預設 20
PLEX_DEFAULT_VOLUME=20

# ============================================
# 選填：Plex 帳號登入（較少用）
# ============================================
# 如果使用 token 認證，通常不需要填這些
# PLEX_USERNAME=your_plex_username
# PLEX_PASSWORD=your_plex_password